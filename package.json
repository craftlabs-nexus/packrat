{
  "name": "@craftlabs/packrat",
  "version": "0.2.0",
  "description": "Reads a Minecraft modpack from wherever it is (a launcher instance or mods folder, a Modrinth .mrpack, a CurseForge zip, a packwiz URL), resolves its files on Modrinth and plans and runs the import, all in the browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craftlabs-nexus/packrat.git"
  },
  "homepage": "https://github.com/craftlabs-nexus/packrat#readme",
  "bugs": {
    "url": "https://github.com/craftlabs-nexus/packrat/issues"
  },
  "keywords": [
    "minecraft",
    "modpack",
    "modrinth",
    "mrpack",
    "packwiz",
    "curseforge",
    "browser"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test:run && npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "smol-toml": "^1.6.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.16"
  }
}
